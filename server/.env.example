# Breeze Connect (ICICI Direct API) credentials
# Get these from https://api.icicidirect.com/apiuser/home after signup
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_SESSION_TOKEN=
# Daily session token — regenerate every morning from your Breeze app login URL

# Server config
PORT=4300
WEB_ORIGIN=http://localhost:5180
USE_MOCK=true
# Set USE_MOCK=false once you've added real credentials above
