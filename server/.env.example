# ============================================================
#  QuantEdge backend environment template
#  COPY this file to `.env` and fill in your own values.
#  NEVER commit .env — it's already in .gitignore.
# ============================================================

# Choose broker (upstox / kotak / breeze / indianapi / mock)
BROKER=upstox

# ============================================================
#  Upstox — primary provider
#  Get keys at: https://account.upstox.com/developer/apps
# ============================================================
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# Daily access token (expires 03:30 IST every day)
# Used for orders + portfolio + profile endpoints.
UPSTOX_ACCESS_TOKEN=

# Extended analytics token (lasts 366 days)
# Required only if you want market data without daily refresh.
# Read-only — cannot place orders.
UPSTOX_EXTENDED_TOKEN=

# OAuth redirect URI — must match what you registered at Upstox.
# Local dev: http://localhost:4300/api/auth/upstox/callback
# Production: https://your-app.up.railway.app/api/auth/upstox/callback
UPSTOX_REDIRECT_URI=http://localhost:4300/api/auth/upstox/callback

# ============================================================
#  IndianAPI fallback (stock movers, daily history for non-indices)
#  https://stock.indianapi.in/
# ============================================================
INDIANAPI_KEY=

# ============================================================
#  Server config
# ============================================================
# Railway / Render inject PORT automatically — leave blank in prod
PORT=4300

# Comma-separated origins allowed by CORS. Add your Vercel URL here once deployed.
WEB_ORIGIN=http://localhost:4300,http://localhost:5180

# ============================================================
#  ML service (optional Python sidecar; disabled by default)
# ============================================================
ML_URL=http://localhost:4400
ML_ENABLED=false
